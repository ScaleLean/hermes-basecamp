# Identity lock. Use the dedicated Basecamp member values for this agent.
BASECAMP_ACCOUNT_ID=1234567
BASECAMP_PERSON_ID=7654321
BASECAMP_PERSON_EMAIL=agent@example.com
BASECAMP_AGENT_MENTION=@AgentName

# Comma-separated project allowlist.
BASECAMP_PROJECT_IDS=11111111

# Owner-only OAuth token file created by an onboarding script.
BASECAMP_OAUTH_TOKEN_FILE=/absolute/path/outside/the/repository/agent-oauth.json

# Inbound trigger policy.
BASECAMP_ALLOWED_USERS=22222222
# Other dedicated Basecamp member IDs operated by agents. Peer activity is
# quiet unless it directly mentions or assigns this agent.
BASECAMP_PEER_AGENT_IDS=33333333,44444444
BASECAMP_POLL_CHAT_SECONDS=15
BASECAMP_POLL_PING_SECONDS=10
BASECAMP_POLL_NOTIFY_SECONDS=45
BASECAMP_POLL_ASSIGNMENT_SECONDS=30
BASECAMP_RECONCILE_SECONDS=300
BASECAMP_STATE_DIR=/absolute/owner-only/basecamp-state
BASECAMP_MEDIA_ROOTS=/absolute/approved/media/root
BASECAMP_WEBHOOK_TOKEN=replace-with-at-least-32-random-characters
BASECAMP_WEBHOOK_HOST=127.0.0.1
BASECAMP_WEBHOOK_PORT=8788
BASECAMP_WEBHOOK_PUBLIC_URL=https://agent-basecamp.example.com/webhooks/basecamp/replace-with-private-path
# Keep the receiver on loopback behind a TLS reverse proxy. Set true only when
# the receiver itself must bind elsewhere and that proxy boundary is verified.
BASECAMP_WEBHOOK_TLS_PROXY=false

# Optional default delivery target.
BASECAMP_HOME_CHANNEL=bucket:11111111/recording:33333333

# Optional separate full-member conductor for `hermes-basecamp test live`.
BASECAMP_CONDUCTOR_PERSON_ID=8765432
BASECAMP_CONDUCTOR_EMAIL=conductor@example.com
BASECAMP_CONDUCTOR_TOKEN_FILE=/absolute/path/outside/the/repository/conductor-oauth.json
